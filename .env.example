# Copy to .env and set real local values. .env is gitignored and never committed.
SECRET_KEY=dev-insecure-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Used by docker-compose to build the database and its connection string.
POSTGRES_DB=netflix
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password

# Used when running pytest on the host (outside Docker). Match the password above.
DATABASE_URL=postgres://postgres:replace-with-a-local-password@localhost:5432/netflix